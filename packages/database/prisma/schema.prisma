generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum QuestStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum LessonKind {
  THEORY
  EXAMPLE
  RECAP
}

enum ExerciseKind {
  MULTIPLE_CHOICE
  CODE
  OUTPUT_PREDICTION
}

enum SubmissionStatus {
  PENDING
  PASSED
  FAILED
  ERROR
}

enum ProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
}

enum UserRole {
  USER
  ADMIN
}

enum ContentAuditAction {
  CREATE
  UPDATE
  PUBLISH
  ARCHIVE
  REORDER
}

model User {
  id          String          @id @default(cuid())
  email       String          @unique
  displayName String?
  passwordHash String?
  role         UserRole        @default(USER)
  sessions     AuthSession[]
  submissions      Submission[]
  progress         QuestProgress[]
  enrollments      Enrollment[]
  exerciseProgress ExerciseProgress[]
  gamification     GamificationProfile?
  xpEvents         XpEvent[]
  achievements     UserAchievement[]
  contentAuditEvents ContentAuditEvent[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model GamificationProfile {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  totalXp       Int      @default(0)
  currentStreak Int      @default(0)
  longestStreak Int      @default(0)
  lastActiveOn  DateTime? @db.Date
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model XpEvent {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount     Int
  reason     String
  sourceType String
  sourceId   String
  createdAt  DateTime @default(now())

  @@unique([userId, sourceType, sourceId])
  @@index([userId, createdAt])
}

model UserAchievement {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug        String
  title       String
  description String
  unlockedAt  DateTime @default(now())

  @@unique([userId, slug])
  @@index([userId, unlockedAt])
}

model AuthSession {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  lastSeenAt DateTime @default(now())
  revokedAt DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@index([userId, revokedAt, lastSeenAt])
}

model Course {
  id          String       @id @default(cuid())
  slug        String       @unique
  title       String
  description String
  status      CourseStatus @default(DRAFT)
  difficulty  Difficulty   @default(BEGINNER)
  version     Int          @default(1)
  publishedAt DateTime?
  updatedById String?
  modules     CourseModule[]
  enrollments Enrollment[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([status])
}

model CourseModule {
  id          String   @id @default(cuid())
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  slug        String
  title       String
  description String?
  position    Int
  quests      Quest[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([courseId, slug])
  @@unique([courseId, position])
  @@index([courseId])
}

model Quest {
  id          String          @id @default(cuid())
  moduleId    String
  module      CourseModule    @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  slug        String          @unique
  title       String
  description String
  status      QuestStatus     @default(DRAFT)
  difficulty  Difficulty      @default(BEGINNER)
  position    Int
  estimatedMinutes Int        @default(15)
  version     Int             @default(1)
  publishedAt DateTime?
  updatedById String?
  lessons     Lesson[]
  exercises   Exercise[]
  progress    QuestProgress[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([moduleId, position])
  @@index([moduleId, status])
}

model Lesson {
  id        String     @id @default(cuid())
  questId   String
  quest     Quest      @relation(fields: [questId], references: [id], onDelete: Cascade)
  slug      String
  title     String
  kind      LessonKind @default(THEORY)
  content   String     @db.Text
  position  Int
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([questId, slug])
  @@unique([questId, position])
  @@index([questId])
}

model Exercise {
  id          String       @id @default(cuid())
  questId     String
  quest       Quest        @relation(fields: [questId], references: [id], onDelete: Cascade)
  slug        String
  title       String
  prompt      String       @db.Text
  kind        ExerciseKind
  difficulty  Difficulty   @default(BEGINNER)
  position    Int
  starterCode String?      @db.Text
  solution    String?      @db.Text
  executionTimeoutMs Int   @default(5000)
  testCases   TestCase[]
  submissions Submission[]
  progress    ExerciseProgress[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([questId, slug])
  @@unique([questId, position])
  @@index([questId])
}

model ContentAuditEvent {
  id         String             @id @default(cuid())
  adminId    String
  admin      User               @relation(fields: [adminId], references: [id], onDelete: Restrict)
  action     ContentAuditAction
  entityType String
  entityId   String
  entitySlug String?
  metadata   Json?
  createdAt  DateTime           @default(now())

  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([adminId, createdAt])
}

model TestCase {
  id             String   @id @default(cuid())
  exerciseId     String
  exercise       Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  input          String?  @db.Text
  expectedOutput String   @db.Text
  isHidden       Boolean  @default(false)
  position       Int
  createdAt      DateTime @default(now())

  @@unique([exerciseId, position])
  @@index([exerciseId])
}

model Submission {
  id          String           @id @default(cuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  exerciseId  String
  exercise    Exercise         @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  sourceCode  String?          @db.Text
  answer      String?          @db.Text
  status      SubmissionStatus @default(PENDING)
  score       Int?
  runtimeMs   Int?
  errorText   String?          @db.Text
  createdAt   DateTime         @default(now())

  @@index([userId, exerciseId, createdAt])
  @@index([exerciseId, status])
  @@index([userId, createdAt])
}

model Enrollment {
  id          String           @id @default(cuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId    String
  course      Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  status      EnrollmentStatus @default(ACTIVE)
  enrolledAt  DateTime         @default(now())
  completedAt DateTime?
  updatedAt   DateTime         @updatedAt

  @@unique([userId, courseId])
  @@index([userId, status])
  @@index([courseId])
}

model ExerciseProgress {
  id          String         @id @default(cuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  exerciseId  String
  exercise    Exercise       @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  status      ProgressStatus @default(NOT_STARTED)
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([userId, exerciseId])
  @@index([userId, status])
  @@index([exerciseId])
}

model QuestProgress {
  id                 String         @id @default(cuid())
  userId             String
  user               User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  questId            String
  quest              Quest          @relation(fields: [questId], references: [id], onDelete: Cascade)
  status             ProgressStatus @default(NOT_STARTED)
  completedExercises Int            @default(0)
  totalExercises     Int            @default(0)
  startedAt          DateTime?
  completedAt        DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@unique([userId, questId])
  @@index([userId, status])
}
