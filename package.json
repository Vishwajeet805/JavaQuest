{
  "name": "javaquets",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev": "dotenv -e .env -- turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "dotenv -e .env.test -- turbo test",
    "typecheck": "turbo typecheck",
    "format": "prettier --write .",
    "db:generate": "dotenv -e .env -- pnpm --filter @javaquets/database db:generate",
    "db:push": "dotenv -e .env -- pnpm --filter @javaquets/database db:push",
    "db:migrate:deploy": "pnpm --filter @javaquets/database db:migrate:deploy",
    "db:seed": "dotenv -e .env -- pnpm --filter @javaquets/database db:seed",
    "runner:build": "docker build -t javaquets-java-runner:local infra/runner"
  },
  "devDependencies": {
    "eslint": "^9.13.0",
    "prettier": "^3.3.3",
    "turbo": "^2.1.3",
    "typescript": "^5.6.3",
    "dotenv-cli": "^7.4.2",
    "typescript-eslint": "^8.11.0"
  },
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma",
      "sharp",
      "unrs-resolver"
    ]
  }
}
